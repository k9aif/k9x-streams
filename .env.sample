# K9X Streams — copy to .env (never commit .env):   cp .env.sample .env

# Kafka. Leave KAFKA_BROKER unset and ./run.sh starts a local Redpanda for you.
# KAFKA_BROKER=localhost:9092

# Organization brokers that require sign-in (Confluent Cloud: SASL_SSL + PLAIN, API key / secret).
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Your topic names (defaults shown).
# STREAMS_TOPIC_INVOICE=ap.invoice.updated
# STREAMS_TOPIC_PAYMENT=ap.payment.posted
# STREAMS_TOPIC_VENDOR=ap.vendor.flagged

# Service port, the MCP URL the agent calls, and the freshness limit (seconds).
# STREAMS_PORT=8780
# STREAMS_MCP_URL=http://localhost:8780/mcp
# STREAMS_MAX_AGE_SECONDS=120

# Container deploy (ubuntu/build-run.sh): reachable from the LAN as well as the tunnel.
# STREAMS_BIND=0.0.0.0
# Use your own Kafka instead of the pod's Redpanda.
# STREAMS_KAFKA=external
